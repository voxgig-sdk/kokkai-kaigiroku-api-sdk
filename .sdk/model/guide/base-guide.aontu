# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 3
  metrics: count: path: 3
  metrics: count: method: 3

  entity: meeting: {
    path: "/meeting": {
      op: list: method: *GET
      op: list: transform: res: *("`body.meetingRecord`")|top
    }
  }

  entity: meeting_list: {
    path: "/meeting_list": {
      op: list: method: *GET
      op: list: transform: res: *("`body.meetingRecord`")|top
    }
  }

  entity: speech: {
    path: "/speech": {
      op: list: method: *GET
      op: list: transform: res: *("`body.speechRecord`")|top
    }
  }

}