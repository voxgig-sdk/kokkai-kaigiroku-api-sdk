  "requests": {
    "GET /speech": {
      "provenance": "operation-contract",
      "contract": {
        "operationId": "getSpeech",
        "parameters": [
          {
            "description": "検索結果の取得開始位置（1～検索件数の範囲）",
            "in": "query",
            "name": "startRecord",
            "schema": {
